@model IReadOnlyList<Species>

@{
    ViewData["Title"] = "Species";
}

<h1>Species</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Rarity</th>
            <th>Rank</th>
            <th>Base Total</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var species in Model)
        {
            <tr>
                <td>
                    <a asp-action="Details" asp-route-id="@species.Id">@species.Name</a>
                </td>
                <td>@species.Type</td>
                <td>@species.Rarity</td>
                <td>@((int)species.Rank)</td>
                <td>@species.TotalBaseStats().Total</td>
            </tr>
        }
    </tbody>
</table>